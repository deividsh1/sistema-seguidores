# Django
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
PUBLIC_BASE_URL=http://127.0.0.1:8000
ORDER_EMAIL_REQUIRED=True
TRUST_X_FORWARDED_FOR=False
TRUST_X_FORWARDED_PROTO=False
WHATSAPP_SUPPORT_NUMBER=
SOCIAL_PROOF_ENABLED=True

# HTTPS em produção
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

PROVIDER_API_URL=https://smmcost.com/api/v2
PROVIDER_API_KEY=
PROVIDER_SIMULATED=True

# Prévia de perfil. Simulado não faz chamadas externas e nunca bloqueia o checkout.
PROFILE_LOOKUP_PROVIDER=searchapi
PROFILE_LOOKUP_API_KEY=
PROFILE_LOOKUP_SIMULATED=True

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=600
PAYMENT_PROVIDER=mercadopago
PAYMENT_SIMULATED=True

# Cache local no desenvolvimento. Em produção, use um cache compartilhado.
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=webmaster-rate-limit
# Produção com múltiplos processos:
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1

# Banco de producao (Railway/Heroku): se DATABASE_URL existir, tem prioridade.
# DATABASE_URL=postgres://user:senha@host:5432/nomedb

# PostgreSQL por variaveis separadas. Sem POSTGRES_DB nem DATABASE_URL, usa SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
